# Copy to backend/.env and fill in your hackathon key.
# Never commit the real key. The React app must not receive it.

MODEL_API_KEY=
META_API_KEY=
META_API_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0

# Optional. If omitted, the API uses a local SQLite file.
# DATABASE_URL=postgresql+psycopg2://munyi:munyi@localhost:5432/munyi

# Set to false before any public deployment of this API.
ENABLE_DEMO_RESET=true
